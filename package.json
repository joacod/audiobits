{
  "name": "audiobits-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:lib": "pnpm --filter audiobits build",
    "build:site": "pnpm build:lib && pnpm --filter @audiobits/www build",
    "build": "pnpm build:lib && pnpm build:prepared",
    "typecheck": "pnpm build:lib && pnpm typecheck:prepared",
    "lint": "eslint . && prettier --check . && node scripts/check-doc-links.mjs",
    "format": "prettier --write .",
    "test": "node scripts/generate-recipe.mjs --check && vitest run --bail=1",
    "test:browser": "pnpm test:browser:full",
    "test:package": "pnpm build:lib && pnpm test:package:prepared",
    "test:package:latest": "pnpm build:lib && node scripts/test-package.mjs --latest",
    "test:package:github": "pnpm build:lib && node scripts/test-package.mjs --github",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/generate-recipe.mjs",
    "release:prepare": "pnpm verify:core && pnpm build:prepared && node scripts/build-audio-tests.mjs && pnpm test:browser:full:prepared --max-failures=1 && pnpm test:package:prepared",
    "build:mcp": "tsc -p tools/mcp/tsconfig.json",
    "test:mcp": "pnpm build:lib && pnpm test:mcp:prepared",
    "test:mcp:github": "pnpm build:lib && pnpm build:mcp && vitest run --config tools/mcp/vitest.github.config.ts",
    "build:skill": "node tools/mcp/build-skill.mjs",
    "check:skill": "node tools/mcp/build-skill.mjs --check",
    "build:prepared": "pnpm --filter @audiobits/www build && pnpm --filter @audiobits/vanilla build",
    "typecheck:prepared": "pnpm --filter @audiobits/www generate && pnpm -r typecheck",
    "test:mcp:prepared": "pnpm build:mcp && node tools/mcp/generate-snapshot.mjs --check && vitest run --config tools/mcp/vitest.config.ts",
    "verify:local": "pnpm verify:core && pnpm check:skill && pnpm test:mcp:prepared",
    "prepare:browser": "pnpm build && node scripts/build-audio-tests.mjs",
    "test:browser:smoke": "pnpm prepare:browser && pnpm test:browser:smoke:prepared",
    "test:browser:smoke:prepared": "playwright test --grep @smoke --max-failures=1",
    "test:browser:full": "pnpm prepare:browser && pnpm test:browser:full:prepared",
    "test:browser:full:prepared": "playwright test",
    "test:package:prepared": "node scripts/test-package.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "verify:core": "pnpm lint && pnpm build:lib && pnpm typecheck:prepared && pnpm test"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "audiobits": "workspace:*",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "shadcn": "4.21.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
