{
  "name": "audiobits",
  "version": "0.2.3",
  "description": "Browser audio engine and recipe language. Copy sounds from the AudioBits catalog and own them.",
  "license": "MIT",
  "homepage": "https://www.audiobits.dev/",
  "keywords": [
    "web-audio",
    "procedural-audio",
    "sound-effects",
    "sfx",
    "game-audio",
    "typescript",
    "ai-agents",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joacod/audiobits.git",
    "directory": "packages/audiobits"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./dist/schema.json",
    "./capabilities.json": "./dist/capabilities.json"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/generate-recipe.mjs && tsdown && node ../../scripts/copy-schema.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.types.json"
  },
  "devDependencies": {
    "tsdown": "0.23.0"
  }
}
