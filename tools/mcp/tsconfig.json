{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "allowJs": true
  },
  "include": ["*.ts", "source-path.mjs", "snapshot.json"],
  "exclude": ["*.test.ts", "vitest*.ts", "fixtures.ts", "dist"]
}
