{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "*.ts",
    "tests/**/*.ts",
    "packages/audiobits/tests/**/*.ts",
    "scripts/**/*.test.ts",
    "tools/mcp/*.test.ts"
  ]
}
