      "kind": "button",
      "refersTo": "button-play",
      "description": "Brass playback action with native focus and disabled states.",
      "html": "<button class=\"ds-play\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" aria-hidden=\"true\"><path d=\"M3 1.5 12 7 3 12.5Z\" fill=\"currentColor\"/></svg>Play impact</button>",
      "css": ".ds-play{font-family:Arial,sans-serif;color:var(--ink, #243c32);display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:44px;padding:.5rem .9rem;border-radius:4px;font-size:.875rem;line-height:1.3;cursor:pointer;transition:background 160ms ease-out,border-color 160ms ease-out;background:var(--accent, #e0b856);border:1px solid transparent;font-weight:600}.ds-play:enabled:hover{background:var(--signal, #ecce82)}.ds-play:focus-visible{outline:3px solid var(--focus, #715600);outline-offset:4px;}.ds-play:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-play{transition:none}}"
    },
