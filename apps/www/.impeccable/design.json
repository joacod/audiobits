      "html": "<button class=\"ds-secondary\">Stop all</button>",
      "css": ".ds-secondary{font-family:Arial,sans-serif;color:var(--ink, #243c32);display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:44px;padding:.5rem .9rem;border-radius:4px;font-size:.875rem;line-height:1.3;cursor:pointer;transition:background 160ms ease-out,border-color 160ms ease-out;background:transparent;border:1px solid var(--rule, #b8c1b3)}.ds-secondary:enabled:hover{background:var(--code, #e8e6db);border-color:var(--ink, #243c32)}.ds-secondary[aria-pressed=\"true\"]{background:var(--accent, #e0b856);border-color:transparent;font-weight:600}.ds-secondary[aria-pressed=\"true\"]:enabled:hover{background:var(--signal, #ecce82)}.ds-secondary:focus-visible{outline:3px solid var(--focus, #715600);outline-offset:4px;}.ds-secondary:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
