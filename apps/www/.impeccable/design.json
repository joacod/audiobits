      "html": "<header class=\"ds-header\"><nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-wordmark\" href=\"#\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle class=\"ds-core\" cx=\"12\" cy=\"12\" r=\"3.1\"/><circle cx=\"12\" cy=\"12\" r=\"7.25\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg>AudioBits</a><div class=\"ds-links\"><a href=\"#\" aria-current=\"page\">Home</a><a href=\"#sounds\">Catalog</a><a href=\"#docs\">Docs</a><a href=\"#github\">GitHub</a></div></nav></header>",
      "css": ".ds-header{background:var(--ink,#243c32);color:var(--paper,#f3f0e6);font-family:Arial,sans-serif}.ds-nav{display:flex;flex-wrap:wrap;align-items:center;gap:.25rem 1rem;padding:.35rem 1.5rem}.ds-links{display:flex;flex-wrap:wrap;gap:.15rem 1.1rem;margin-left:auto}.ds-nav a{color:var(--paper,#f3f0e6);display:inline-flex;align-items:center;gap:.45rem;min-height:44px;font-size:.95rem;text-decoration:none}.ds-nav a:hover{color:var(--signal,#ecce82)}.ds-nav a[aria-current=page]{color:var(--signal,#ecce82);text-decoration:underline;text-underline-offset:.45rem}.ds-nav a:focus-visible{outline:3px solid var(--signal,#ecce82);outline-offset:4px}.ds-wordmark{font-family:Fraunces,Georgia,serif;font-size:1.35rem;font-weight:520;letter-spacing:-.03em}.ds-wordmark:hover{color:var(--paper,#f3f0e6)}.ds-core{fill:var(--accent,#e0b856)}.ds-wordmark:hover .ds-core{fill:var(--signal,#ecce82)}@media(max-width:760px){.ds-links{flex-basis:100%;margin-left:0}}"
