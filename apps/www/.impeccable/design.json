  "narrative": {
    "northStar": "The charge housing",
    "overview": "The homepage is one mineral-green housing. The header and the Energy Charge hero share that field, so the instrument is the first thing a visitor can hold. Warm paper is reserved for labels, code, and the footer plate. Brass marks charge and primary playback. Pale signal marks action and focus while the ground is green.\n\nCatalog and experience routes keep their paper benches and their existing workbench layouts. They share the same header, type, controls, and tokens. Documentation stays on Fumadocs and does not inherit the housing. Fraunces remains the voice because the charge numeral and the headline already use it.",
    "keyCharacteristics": [
      "Mineral-green housing on the homepage, warm paper on catalog and experience benches.",
      "Brass for charge, Play, and pressed controls. Pale signal for housing focus, current navigation, and primary text actions.",
      "Fraunces for the voice, Arial for controls, monospace only for code.",
      "Hairline rules and flat surfaces. No cards, glass, neon, or shadows.",
      "One live Energy Charge engine on the homepage. Supporting previews stay static."
    ],
    "rules": [
      {
        "name": "The Housing Rule",
        "body": "The homepage ground is ink. Paper is for labels, code, and the footer plate. Do not paint the catalog or a workbench as a second dark marketing page.",
        "section": "colors"
      },
      {
        "name": "The Brass State Rule",
        "body": "Use brass for Play, the hold meter, and pressed controls. Ordinary actions stay transparent with a fine rule.",
        "section": "colors"
      },
      {
        "name": "The Voice Rule",
        "body": "Fraunces is for the voice and the charge numeral. Arial is for controls. Monospace is only for code.",
        "section": "typography"
      },
      {
        "name": "The Ruled Surface Rule",
        "body": "Separate sections and specimens with hairline rules. Do not add floating-card shadows, glass, or a second decorative field behind the charge well.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep Hold to charge as the homepage's primary action, with Explore the catalog and Start building as the text actions.",
      "Do take the package version from generated metadata.",
      "Do keep keyboard and touch targets at least (44px), including header, copy, and footer actions.",
      "Do reset paper-surface focus to ochre wherever the housing has switched focus to signal.",
      "Do let code wrap or scroll inside its own panel."
    ],
    "donts": [
      "Don't mount a second live audio engine on the homepage.",
      "Don't autoplay, rotate the hero, or add a decorative effect that competes with the charge well.",
      "Don't restyle Fumadocs with the showcase housing.",
      "Don't invent performance, package-size, adoption, or popularity claims.",
      "Don't replace Fraunces on the charge numeral or the homepage headline. The face is part of the instrument."
    ]
  }
}
