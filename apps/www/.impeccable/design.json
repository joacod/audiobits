      "css": ".ds-install{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem .75rem;font-family:Arial,sans-serif}.ds-install code{background:var(--code,#e8e6db);color:var(--ink,#243c32);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.85rem;line-height:1.4;padding:.5rem .75rem;border-radius:4px}.ds-install button{min-height:44px;padding:.5rem .9rem;border:1px solid var(--instrument-line,#768b7d);border-radius:4px;background:transparent;color:var(--paper,#f3f0e6);font-size:.875rem;cursor:pointer}.ds-install button:hover{background:var(--signal,#ecce82);color:var(--ink,#243c32);border-color:var(--signal,#ecce82)}.ds-install button:focus-visible{outline:3px solid var(--signal,#ecce82);outline-offset:4px}"
