{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "audiobits",
  "homepage": "https://github.com/joacod/audiobits",
  "items": [
    {
      "name": "confirmation",
      "type": "registry:item",
      "title": "Confirmation",
      "description": "A short rising confirmation tone as editable recipe source.",
      "dependencies": ["audiobits"],
      "categories": ["recipe"],
      "meta": {
        "classification": "recipe",
        "tags": ["confirmation", "one-shot"],
        "schemaVersion": 1,
        "compatibility": {
          "runtime": "audiobits public API with recipe schema 1",
          "language": "TypeScript",
          "moduleResolution": "Bundler",
          "browser": "Web Audio; automated verification in Chromium",
          "framework": "none"
        }
      },
      "files": [
        {
          "path": "catalog/recipes/confirmation/recipe.ts",
          "type": "registry:file",
          "target": "~/src/sounds/confirmation.ts"
        },
        {
          "path": "LICENSE",
          "type": "registry:file",
          "target": "~/src/sounds/confirmation.LICENSE"
        }
      ],
      "docs": "You own the installed source. Customize it locally and retain the MIT license. See https://github.com/joacod/audiobits/blob/main/catalog/README.md for integration and update guidance."
    },
    {
      "name": "energy-charge",
