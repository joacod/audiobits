        },
        {
          "path": "catalog/experiences/energy-charge/progress.ts",
          "type": "registry:file",
          "target": "~/src/sounds/energy-charge/progress.ts"
        },
        {
          "path": "catalog/experiences/energy-charge/host.ts",
          "type": "registry:file",
          "target": "~/src/sounds/energy-charge/host.ts"
        },
        {
