      "title": "Energy Charge",
      "description": "A sustained energy field with progress controller, browser host and standalone demo.",
      "dependencies": ["audiobits"],
      "categories": ["experience"],
      "meta": {
        "classification": "experience",
        "tags": ["energy", "sustained", "progress"],
        "schemaVersion": 1,
        "compatibility": {
          "runtime": "audiobits public API with recipe schema 1",
          "language": "TypeScript",
          "moduleResolution": "Bundler",
          "browser": "Web Audio; automated verification in Chromium",
          "framework": "none"
        }
      },
      "files": [
        {
